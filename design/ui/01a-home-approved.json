{
  "screenId": "home-approved",
  "title": "היום שלי",
  "locale": "he-IL",
  "direction": "rtl",
  "designSystem": "00-design-system.json",
  "exampleDataOnly": true,
  "source": {
    "description": "Simplified home (v2). Supersedes the v1 approved home; banner, wordmark and greeting are unchanged."
  },
  "layout": {
    "headerVariant": "home",
    "header": [
      "banner image",
      "Luma wordmark (upper right)",
      "greeting",
      "bell (left)",
      "add + (left)"
    ],
    "navigation": "shared bottom navigation",
    "activeTab": "home",
    "components": [
      {
        "id": "date",
        "type": "textLine",
        "sample": "יום שני, 30 בנובמבר",
        "rules": "weekday and Gregorian date once; no year, no Hebrew date, no location/duty/hours"
      },
      {
        "id": "current",
        "type": "activityCard",
        "sample": {
          "label": "עכשיו",
          "title": "מענה לטלפונים ולפניות ב-CRM",
          "time": "09:00-13:00",
          "remaining": "נותרו 2:40",
          "next": "אחר כך: הפסקה · 13:00"
        },
        "states": {
          "several": "each current activity as a compact row",
          "next": "label הפעילות הבאה + time until it",
          "noneLeft": "אין עוד פעילויות היום",
          "noActivities": "אין פעילויות היום"
        }
      },
      {
        "id": "counter",
        "type": "counterCard",
        "sample": {
          "label": "פניות היום",
          "count": 3,
          "target": 10
        },
        "controls": [
          "round minus (disabled at 0)",
          "round plus (primary)",
          "איפוס text button with confirmation"
        ],
        "indicator": "thin progress bar; green when target reached"
      },
      {
        "id": "priorities",
        "type": "section",
        "title": "3 המשימות החשובות שלי להיום",
        "rows": "checkbox + title + remove",
        "add": "בחירת משימה (dashed add-row) while fewer than three"
      }
    ]
  },
  "excluded": [
    "workday progress",
    "carried tasks",
    "today's task list",
    "alerts",
    "shortcut tiles",
    "non-working-day cards",
    "phone duty",
    "office/home"
  ]
}
