{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "luma-work-plan.v2.schema.json",
  "title": "Luma work plan (luma-work-plan) v2",
  "description": "Additive planning patch produced externally (e.g. by ChatGPT) and imported locally after a read-only preview and explicit approval. Adds activities and tasks next to the existing schedule; never deletes, moves or replaces anything, and never changes recurring activities. Overlaps with existing activities are allowed. Unknown optional values are omitted or null (null = unknown). Limits: 1 MiB, 500 items. Semantic rules (week range, end > start, end/duration agreement) are enforced by js/data/importPlan.js. Version 1 files are still accepted and normalized (blocks and timed meetings become activities; day settings, team questions and undated meetings are listed as not imported).",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "kind", "planId"],
  "properties": {
    "format": { "const": "luma-work-plan" },
    "schemaVersion": { "const": 2 },
    "kind": { "enum": ["weekly", "dailyPatch"] },
    "planId": { "$ref": "#/$defs/id" },
    "weekStart": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }], "description": "Sunday ISO date; required when kind = weekly" },
    "activities": {
      "type": "array",
      "description": "Timed calendar activities (e.g. a meeting). Recurrence is not supported in imports.",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["externalId", "date", "title"],
        "properties": {
          "externalId": { "$ref": "#/$defs/id" },
          "date": { "$ref": "#/$defs/date" },
          "title": { "type": "string", "minLength": 1, "maxLength": 300 },
          "start": { "anyOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] },
          "end": { "anyOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] },
          "durationMinutes": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 720 }, { "type": "null" }] },
          "notes": { "anyOf": [{ "type": "string", "maxLength": 2000 }, { "type": "null" }] }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["externalId", "title"],
        "properties": {
          "externalId": { "$ref": "#/$defs/id" },
          "title": { "type": "string", "minLength": 1, "maxLength": 300 },
          "scheduledDate": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }], "description": "Execution date" },
          "deadline": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
          "priority": { "anyOf": [{ "enum": ["high", "medium", "low"] }, { "type": "null" }] },
          "notes": { "anyOf": [{ "type": "string", "maxLength": 2000 }, { "type": "null" }] }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[\\p{L}\\p{N}][\\p{L}\\p{N}._:-]{0,99}$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" }
  }
}
