{
  "screenId": "agenda",
  "title": "סדר היום",
  "locale": "he-IL",
  "direction": "rtl",
  "designSystem": "00-design-system.json",
  "exampleDataOnly": true,
  "layout": {
    "headerVariant": "secondary",
    "activeTab": "agenda",
    "components": [
      {
        "id": "dateNav",
        "type": "dateNavigation",
        "sample": "יום שני, 30 בנובמבר",
        "rules": "arrows on both sides; tapping the date opens the native picker; optional small היום button when another date is shown"
      },
      {
        "id": "mode",
        "type": "segmented",
        "options": [
          "רשימה",
          "ציר שעות"
        ]
      },
      {
        "id": "list",
        "type": "activityCards",
        "card": [
          "start-end",
          "title",
          "short note (max two lines)",
          "completion checkbox",
          "⋯ menu: הושלם חלקית, דילוג, ביטול הפעילות, עריכה"
        ],
        "states": [
          "current (soft blue)",
          "done (struck)",
          "partial/skipped/canceled (small status line)"
        ]
      },
      {
        "id": "timeline",
        "type": "hourGrid",
        "rules": "single day, no header row; overlapping activities in side-by-side lanes; tap to edit; long-press/drag to move; bottom handle to resize; Alt+arrows on keyboard",
        "after": "הוספת פעילות button"
      },
      {
        "id": "notes",
        "type": "textarea",
        "placeholder": "הערות",
        "rules": "one field for the day, shared by both modes, saved when left"
      }
    ]
  },
  "excluded": [
    "Hebrew date",
    "duty strip",
    "workday labels",
    "delay/planner/move/export/print buttons",
    "achievements",
    "reflection",
    "instructions"
  ]
}
