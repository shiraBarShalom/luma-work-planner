            "type": "text",
            "label": "תיאור המשימה",
            "required": true
          },
          {
            "key": "priority",
            "type": "select",
            "label": "עדיפות",
            "options": [
              "גבוהה",
              "בינונית",
              "נמוכה"
            ]
          },
          {
            "key": "dueDate",
            "type": "date",
            "label": "תאריך יעד",
            "required": false
          }
        ],
        "primaryAction": {
          "label": "הוסף משימה",
          "action": "saveTask"
        },
        "secondaryAction": {
          "icon": "x",
          "action": "close"
        }
      },
      {
        "id": "details",
        "type": "optionalExpandedFields",
        "fields": [
          "category",
          "executionDate",
          "estimatedDuration",
          "notes",
          "subtasks"
        ]
      }
    ]
  },
  "implementationNotes": [
    "Advanced fields come from the original brief, not visible in the modal.",
