{
  "screenId": "calendar",
  "title": "יומן",
  "locale": "he-IL",
  "direction": "rtl",
  "designSystem": "00-design-system.json",
  "exampleDataOnly": true,
  "layout": {
    "headerVariant": "secondary",
    "activeTab": "calendar",
    "components": [
      {
        "id": "mode",
        "type": "segmented",
        "options": [
          "חודש",
          "שבוע",
          "יום"
        ]
      },
      {
        "id": "month",
        "type": "monthGrid",
        "navigation": "arrows + month select + year field",
        "cell": "day number (today filled), up to three dots for one-off activities, a red dot for deadlines",
        "tap": "opens day view",
        "below": "nothing"
      },
      {
        "id": "week",
        "type": "hourGrid",
        "navigation": "arrows + week range text (tap to pick a date)",
        "header": "weekday letter + d.m",
        "rules": "titles only in narrow columns; drag across days and hours; resize"
      },
      {
        "id": "day",
        "type": "hourGrid",
        "navigation": "same as agenda",
        "after": "הוספת פעילות"
      }
    ]
  },
  "excluded": [
    "legend",
    "selected-day summary",
    "inquiry/workday/task summaries",
    "weekly task list",
    "import/export/print",
    "instructions"
  ]
}
