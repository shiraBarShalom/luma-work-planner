    "observed": [
      "The reference shows a rounded white modal, X left, title right, one text field, two selectors and blue submit button."
    ],
    "exampleDataOnly": true
  },
  "layout": {
    "headerVariant": "secondary",
    "scroll": "vertical",
    "navigation": "shared bottom navigation",
